# Java 主后端生产环境变量模板
# 复制到 /etc/jarvis/java.env，并 chmod 600。

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
DB_USERNAME=jarvis
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# JWT：至少 32 字节随机值，生产必须独立生成。
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES

# Java -> Python 内部服务令牌；必须与 python.env 完全一致。
PYTHON_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

# 只允许正式前端与必要本地开发源。
CORS_ALLOWED_ORIGINS=https://f.shengxia.me

# 秒级行情：1s 采集/广播、30s 数据库快照；公开 SSE 默认最多 2000 个并发订阅者。
MARKET_LIVE_POLL_INTERVAL_MS=1000
MARKET_STREAM_INTERVAL_MS=1000
MARKET_STREAM_MAX_SUBSCRIBERS=2000
MARKET_PERSIST_INTERVAL_MS=30000
JD_LIVE_POLL_INTERVAL_MS=1000
JD_PERSIST_INTERVAL_MS=30000

# 可选：启动时将已存在的该邮箱提升为管理员。完成初始化后建议移除或清空。
BOOTSTRAP_ADMIN_EMAIL=

# 邮箱验证码（Resend）。生产注册默认要求邮箱验证。
AUTH_REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
RESEND_FROM=JARVIS 投研 <noreply@your-domain.example>

# GitHub OAuth（可选；启用前需在 GitHub OAuth App 配置同一回调地址）。
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://agent.shengxia.me/api/auth/github/callback
GITHUB_FRONTEND_REDIRECT_URI=https://f.shengxia.me

# HttpOnly Cookie 生产配置由 application-prod.yml 默认提供：
# Secure=true, SameSite=Strict, host-only cookie。
# jarvis_device 是匿名随机设备标识，仅用于认证限流，不包含用户身份信息；可按需改名。
AUTH_DEVICE_COOKIE_NAME=jarvis_device
