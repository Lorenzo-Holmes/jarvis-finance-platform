# JARVIS 生产健康监控配置
# 安装到 /etc/jarvis/monitor.env，建议 root:root 0600。

# 可选：Slack/Discord/兼容 webhook。留空时只写 journald。
ALERT_WEBHOOK_URL=

# 磁盘剩余百分比低于该值报警。
DISK_PATH=/
DISK_MIN_FREE_PERCENT=15

# Java management/Prometheus 仅本机可访问。
JAVA_METRICS_URL=http://127.0.0.1:8201/actuator/prometheus

# PostgreSQL 备份检查。
POSTGRES_BACKUP_DIR=/var/backups/jarvis/postgres
POSTGRES_BACKUP_MAX_AGE_HOURS=30
REQUIRE_POSTGRES_BACKUP=true

# Python 内部令牌来源；监控脚本只读取 PYTHON_SERVICE_TOKEN。
PYTHON_ENV=/etc/jarvis/python.env

# 状态文件用于抑制重复告警。
MONITOR_STATE_DIR=/var/lib/jarvis-monitor
