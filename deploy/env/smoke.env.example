# 生产 smoke test 专用账号。复制到 /etc/jarvis/smoke.env，权限 600 root:root。
# 建议创建独立低权限测试用户，不要使用真实管理员/个人账号。
SMOKE_API_BASE=https://agent.shengxia.me
SMOKE_EMAIL=smoke@example.invalid
SMOKE_PASSWORD=CHANGE_ME_TEST_ACCOUNT_PASSWORD

# 本机 readiness 探针。
LOCAL_API_BASE=http://127.0.0.1:8200

# 生产应保持 1，验证旧 /py 公网入口已被 Nginx 拒绝。
CHECK_PY_BLOCK=1
