@startuml
left to right direction
skinparam shadowing false
skinparam dpi 140
actor "普通用户" as U
actor "Java 业务后端" as J
actor "Python AI 服务" as P
actor "AI 模型服务" as A
rectangle "AI 投研助手" {
  usecase "发送问题" as C
  usecase "流式返回" as S
  usecase "校验权限与配额" as Q
  usecase "生成风险提示" as R
}
U --> C
C ..> Q : <<include>>
C ..> S : <<include>>
C ..> R : <<include>>
J --> Q
J --> P
P --> A
@enduml
