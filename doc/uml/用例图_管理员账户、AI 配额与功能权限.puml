@startuml
left to right direction
skinparam shadowing false
skinparam dpi 140
actor "管理员" as U
rectangle "管理员账户、AI 配额与功能权限" {
  usecase "搜索用户账户" as UC1
  usecase "调整 AI 配额" as UC2
  usecase "分配功能权限" as UC3
  usecase "查看操作审计" as UC4
}
U --> UC1
U --> UC2
U --> UC3
U --> UC4
UC1 -[hidden]down- UC2
UC2 -[hidden]down- UC3
UC3 -[hidden]down- UC4
@enduml
