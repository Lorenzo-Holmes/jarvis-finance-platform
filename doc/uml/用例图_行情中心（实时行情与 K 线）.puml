@startuml
left to right direction
skinparam shadowing false
skinparam dpi 140
actor "普通用户" as U
actor "行情数据源" as M
rectangle "行情中心" {
  usecase "选择市场与标的" as A
  usecase "查看实时报价" as B
  usecase "查看 K 线" as C
  usecase "查看技术指标" as D
  usecase "获取缓存兜底" as E
}
U --> A
U --> B
U --> C
U --> D
B ..> E : <<extend>>
C ..> E : <<extend>>
M --> B
M --> C
@enduml
