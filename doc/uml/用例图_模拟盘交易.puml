@startuml
left to right direction
skinparam shadowing false
skinparam dpi 140
actor "普通用户" as U
actor "行情服务" as M
rectangle "模拟盘交易" {
  usecase "提交模拟订单" as A
  usecase "校验余额与保证金" as B
  usecase "管理持仓" as C
  usecase "触发强平" as D
  usecase "查看成交记录" as E
}
U --> A
U --> C
U --> E
A ..> B : <<include>>
B ..> M : <<include>>
D ..> M : <<include>>
@enduml
